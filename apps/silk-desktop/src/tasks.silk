//! The app and its tasks: `silk dev` opens it in a window, and Vite replaces the modules an
//! edit touches; `silk build --release` builds the release program, bundle inside, into
//! build/<triple>/release/, and `--out <dir>` also copies it to `<dir>/window/`.
import silkui.app { Access, App, Framework, Runtime, Target, TitleBar, Window, Built, Running }
import silk.build.graph { Options, BuildError }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

/// The app: what it is written in and where it runs. The program in dist/ takes the project's name.
effect fn app() -> App
  ! OutOfMemoryError
  ? &mut Allocator {
  return run App.make("t3code-silk")
    |> App.framework(Framework.react("."))
    // A pnpm workspace package: `vp build` makes dist/app.js and dist/app.sheet first.
    |> App.prebuilt("dist/app.js")
    // As in apps/desktop on macOS (hiddenInset): the app draws its 52 pixel top bar under the
    // window buttons, which sit 16 pixels in and centred on that bar.
    |> App.target(Target.window(Window { title: "T3 Code", width: 1280.0, height: 820.0 })
      .titleBar(TitleBar.transparent(52.0).buttons(16.0, 19.0)))
    // The window starts the T3 server and reads its files: the full Node runtime.
    |> App.runtime(Runtime.node())
    // Libraries such as Base UI add style elements at run time.
    |> App.runtimeStylesheets()
    |> App.allow(Access.Files)
    |> App.allow(Access.Processes)
    // The terminal (ghostty) and the diff highlighter run WebAssembly.
    |> App.allow(Access.Wasm)
}

union Tasks {
  Build { pub options: Options, pub out: String },
  Run { pub options: Options },
  Dev { pub options: Options },
  Plan { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the app")
      |> Command.variant("Build", "Build the app into build/ (--release optimizes)")
      |> Command.variant("Run", "Build the app and run it")
      |> Command.variant("Dev", "Run the app with the development tools, and update it on change")
      |> Command.variant("Plan", "Write the editor's compilation requests")
      |> Command.flatten("options")
      |> Command.option("out", Opt.about("Also copy the app to this directory"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Build { options, out } => run app()
        |> App.build(&options)
        |> Built.write(out.view())
      Tasks.Run { options } => run app()
        |> App.build(&options)
        |> Built.launch()
        |> Running.watch()
      Tasks.Dev { options } => run app()
        |> App.dev(&options)
        |> Built.launch()
        |> Running.watch()
      Tasks.Plan { options } => {
        let configured = run app()
        let graph = run configured.compilations(&options)
        drop run graph.write()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
